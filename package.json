{
  "name": "datadeck",
  "version": "0.1.3",
  "private": true,
  "description": "Windows desktop app for monthly data processing and PPT generation.",
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "test:ppt": "node scripts/ppt-regression.mjs",
    "dev": "electron-vite dev --watch --outDir dist-electron",
    "build": "vue-tsc --noEmit && electron-vite build --outDir dist-electron",
    "preview": "electron-vite preview --outDir dist-electron",
    "pack:win": "npm run build && electron-builder --win dir",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^4.5.3",
    "jszip": "^3.10.1",
    "pptxgenjs": "^3.12.0",
    "remixicon": "^4.6.0",
    "simplebar": "^6.3.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/typescript-plugin": "^3.2.8",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vue-tsc": "^2.2.10"
  },
  "build": {
    "appId": "com.zhero.datadeck",
    "productName": "DataDeck",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-Setup.${ext}",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icons",
        "to": "icons"
      },
      {
        "from": "docs/monthly-data-generated-202603.xlsx",
        "to": "templates/monthly-data-generated-202603.xlsx"
      },
      {
        "from": "docs/staff-data-generated-202603.xlsx",
        "to": "templates/staff-data-generated-202603.xlsx"
      },
      {
        "from": "docs/editors-journals.xlsx",
        "to": "templates/editors-journals.xlsx"
      },
      {
        "from": "docs/Section Health月会.pptx",
        "to": "templates/Section Health月会.pptx"
      }
    ],
    "win": {
      "icon": "build/icons/favicon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "installerIcon": "build/icons/favicon.ico",
      "uninstallerIcon": "build/icons/favicon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
